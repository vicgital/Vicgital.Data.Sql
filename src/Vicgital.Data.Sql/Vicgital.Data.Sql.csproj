
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <AssemblyName>Vicgital.Data.Sql</AssemblyName>
	  <PackageId>Vicgital.Data.Sql</PackageId>
	  <Version>2.0.0</Version>
	  <Authors>Vicgital</Authors>
	  <RepositoryUrl>https://github.com/vicgital/Vicgital.Data.Sql</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageDescription>Core SQL data access abstractions (repository, unit of work, connection factory) for Vicgital services. ORM-agnostic - reference Vicgital.Data.Sql.Dapper and/or Vicgital.Data.Sql.EF for an implementation.</PackageDescription>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

</Project>
